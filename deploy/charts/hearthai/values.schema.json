{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "url",
    "sessionSecret",
    "llm",
    "auth"
  ],
  "properties": {
    "url": {
      "type": "string",
      "pattern": "^https://[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
    },
    "sessionSecret": {
      "type": "object",
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "llm": {
      "type": "object",
      "required": [
        "baseUrl",
        "apiKeySecret"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s;]+$"
        },
        "apiKeySecret": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "oidc",
            "local"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "oidc"
              }
            }
          },
          "then": {
            "required": [
              "oidc"
            ],
            "properties": {
              "oidc": {
                "type": "object",
                "required": [
                  "discoveryUrl",
                  "credentialsSecret"
                ],
                "properties": {
                  "discoveryUrl": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$"
                  },
                  "credentialsSecret": {
                    "type": "object",
                    "required": [
                      "name",
                      "clientIdKey",
                      "clientSecretKey"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "clientIdKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "clientSecretKey": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "local"
              }
            }
          },
          "then": {
            "required": [
              "local"
            ],
            "properties": {
              "local": {
                "type": "object",
                "required": [
                  "adminSecret"
                ],
                "properties": {
                  "adminSecret": {
                    "type": "object",
                    "required": [
                      "name",
                      "emailKey",
                      "passwordKey"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "emailKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "passwordKey": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "localInference": {
      "type": "object",
      "description": "Model names served only by a machine on the owner's network, with no cloud backend.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Add the local models to the LiteLLM catalogue."
        },
        "upstreamUrl": {
          "type": "string",
          "description": "Address of the local Ollama host. Required when enabled."
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "ollamaModel",
              "contextWindow"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]+$",
                "description": "Model name callers request; must not contain '*'."
              },
              "ollamaModel": {
                "type": "string",
                "minLength": 1,
                "description": "Model tag served by Ollama."
              },
              "contextWindow": {
                "type": "integer",
                "minimum": 1,
                "description": "Advertised max input tokens."
              }
            }
          }
        },
        "gate": {
          "type": "object",
          "description": "The proxy in front of the local host.",
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "responseHeaderTimeout": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m|h)$",
              "description": "Go duration, for example 180s."
            },
            "networkPolicy": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "additionalIngress": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "namespace",
                      "matchLabels"
                    ],
                    "properties": {
                      "namespace": {
                        "type": "string",
                        "minLength": 1
                      },
                      "matchLabels": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
