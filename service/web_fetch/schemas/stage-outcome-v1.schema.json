{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthai.local/schemas/stage-outcome-v1.schema.json",
  "title": "Stage outcome, version 1",
  "description": "How one stage ended. A stage reports a fixed code and never a message, so what went wrong at the network level does not become text a model reads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage_version", "stage", "run_id", "code"],
  "properties": {
    "stage_version": {"const": 1},
    "stage": {"enum": ["fetch", "inspect"]},
    "run_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "code": {
      "type": ["string", "null"],
      "description": "Null on success.",
      "enum": [null, "content_rejected", "inspection_failed", "unsafe_source", "unsupported_content", "response_limit_exceeded", "fetch_failed", "deadline_exceeded", "internal_error"]
    }
  }
}
