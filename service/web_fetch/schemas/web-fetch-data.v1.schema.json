{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthai.invalid/schemas/web-fetch-data.v1.schema.json",
  "title": "WebFetchData",
  "description": "Typed payload carried by a successful web_fetch:v1 envelope. Every remote-influenced string here has been inspected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "final_url",
    "http_status",
    "content_type",
    "retrieved_at",
    "format",
    "conversion_method",
    "content"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^source-[0-9a-z]{1,32}$",
      "description": "Run-scoped opaque identifier. Never a filesystem path or download handle."
    },
    "final_url": {"type": "string", "minLength": 8, "maxLength": 2048},
    "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "content_type": {"type": "string", "minLength": 3, "maxLength": 128},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "format": {"type": "string", "enum": ["markdown", "text", "html"]},
    "conversion_method": {
      "type": "string",
      "enum": ["native", "extracted", "basic", "passthrough", "source"],
      "description": "Server-owned identifier for the converter that produced content. Never a suggestion, URL, or instruction."
    },
    "content": {"type": "string", "maxLength": 1048576}
  }
}
