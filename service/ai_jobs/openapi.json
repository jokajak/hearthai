{
  "openapi": "3.1.0",
  "info": {"title": "HearthAI Web Research", "version": "0.3.0"},
  "paths": {
    "/healthz": {"get": {"operationId": "health", "responses": {"200": {"description": "Process is healthy"}}}},
    "/readyz": {"get": {"operationId": "ready", "responses": {"200": {"description": "Service can accept work"}}}},
    "/v1/tools/web-research": {
      "post": {
        "operationId": "webResearch",
        "parameters": [{
          "name": "Idempotency-Key", "in": "header", "required": true,
          "schema": {"type": "string", "format": "uuid"},
          "description": "Adapter-generated identity for one logical invocation."
        }],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebResearchRequest"}}}},
        "responses": {
          "200": {"description": "Completed research", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebResearchResult"}}}},
          "400": {"description": "Invalid request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolFailure"}}}},
          "503": {"description": "Temporarily unavailable", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolFailure"}}}},
          "504": {"description": "Deadline exceeded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolFailure"}}}}
        }
      }
    }
  },
  "components": {"schemas": {
    "WebResearchRequest": {
      "type": "object", "additionalProperties": false, "required": ["question"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 8000},
        "depth": {"type": "string", "enum": ["quick", "standard"], "default": "standard"},
        "source_limit": {"type": "integer", "minimum": 1, "maximum": 12, "default": 8}
      }
    },
    "Evidence": {"type": "object", "additionalProperties": false, "required": ["source_id", "support"], "properties": {"source_id": {"type": "string", "maxLength": 64}, "support": {"type": "string", "maxLength": 2000}}},
    "Finding": {"type": "object", "additionalProperties": false, "required": ["statement", "evidence", "confidence"], "properties": {"statement": {"type": "string", "maxLength": 4000}, "evidence": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/components/schemas/Evidence"}}, "confidence": {"type": "string", "enum": ["low", "medium", "high"]}}},
    "Source": {"type": "object", "additionalProperties": false, "required": ["id", "url", "title", "retrieved_at"], "properties": {"id": {"type": "string", "maxLength": 64}, "url": {"type": "string", "format": "uri", "maxLength": 2048}, "title": {"type": "string", "maxLength": 500}, "retrieved_at": {"type": "string", "format": "date-time"}}},
    "WebResearchResult": {"type": "object", "additionalProperties": false, "required": ["summary", "findings", "sources", "conflicts", "limitations"], "properties": {"summary": {"type": "string", "maxLength": 12000}, "findings": {"type": "array", "maxItems": 20, "items": {"$ref": "#/components/schemas/Finding"}}, "sources": {"type": "array", "maxItems": 12, "items": {"$ref": "#/components/schemas/Source"}}, "conflicts": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 2000}}, "limitations": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 2000}}}},
    "ToolFailure": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "enum": ["invalid_request", "temporarily_unavailable", "deadline_exceeded", "provider_unavailable", "unsafe_source", "incomplete_research", "internal_error"]}, "message": {"type": "string", "maxLength": 500}}}
  }}
}
